#!/usr/bin/env bash
set -euo pipefail
umask 022
readero_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readero_version=$(python3 -c 'import pathlib,tomllib,sys; print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["package"]["version"])' "$readero_root/Cargo.toml")
readero_binary=${1:-$readero_root/target/release/readero}
readero_dist=${2:-$readero_root/dist}
readero_arch=$(dpkg --print-architecture)
readero_stage=$(mktemp -d /tmp/readero-package.XXXXXX)
trap 'rm -rf -- "$readero_stage"' EXIT
chmod 755 "$readero_stage"
python3 "$readero_root/scripts/local-install.py" install --binary "$readero_binary" --prefix /usr --destdir "$readero_stage"
mkdir -p "$readero_stage/DEBIAN" "$readero_dist"
mkdir -p "$readero_stage/debian/readero/DEBIAN"
cat > "$readero_stage/debian/control" <<CONTROL
Source: readero
Section: text
Priority: optional
Maintainer: Readero contributors

Package: readero
Architecture: $readero_arch
Description: A quiet native document reader for Ubuntu
CONTROL
cp -a "$readero_stage/usr" "$readero_stage/debian/readero/"
readero_dependencies=$(cd "$readero_stage" && dpkg-shlibdeps -O -edebian/readero/usr/bin/readero)
readero_dependencies=${readero_dependencies#shlibs:Depends=}
rm -rf -- "$readero_stage/debian"
cat > "$readero_stage/DEBIAN/control" <<CONTROL
Package: readero
Version: $readero_version
Architecture: $readero_arch
Maintainer: Readero contributors
Section: text
Priority: optional
Depends: $readero_dependencies
Description: A quiet native document reader for Ubuntu
 Read local PDF, EPUB and Markdown documents with remembered positions,
 optional focus mode, bookmarks, search and adjustable reading appearance.
CONTROL
dpkg-deb --root-owner-group --build "$readero_stage" "$readero_dist/readero_${readero_version}_${readero_arch}.deb"
